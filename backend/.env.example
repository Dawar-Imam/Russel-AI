PROJECT_NAME=Russel.AI
# API_V1_PREFIX=/api/v1
# ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/russel_ai
CORS_ORIGINS=["http://localhost:5173"]
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLAMA_CLOUD_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9
# Set to false in dev/test to disable all fail-case enforcement (cheating, leave detection, score-based fail)
ENABLE_FAIL_CASES=true
# For LangSmith
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=russell-recruiter-ats
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
# OTP email delivery (see app/core/mailer.py) — leave SMTP_HOST empty in dev to log instead of send
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@russel.ai
# Public HTTPS URL for Google Calendar push notifications (must be reachable by Google).
# In local dev, expose backend port 8000 with ngrok (`ngrok http 8000`) and set this to
# <ngrok-https-url>/api/google-calendar/webhook — see README.md's "Local development:
# exposing the Calendar webhook" section. http://localhost:... will never work here.
GOOGLE_WEBHOOK_URL=
